# Copy this file to .env on the agent box and fill in the real values.
# Never commit a real .env to git.

# From TSB Platform, logged in as owner: Venue Control -> Sites card ->
# "Generate agent token" next to this location. Shown once -- copy it
# straight in here.
AGENT_TOKEN=

# Only change this if TSB Platform's own URL ever changes.
CLOUD_URL=https://bar-ops-platform-52n1.onrender.com

# Gates /api/discovery/* (network scanning + adopting devices) and
# /api/admin/*, /api/backup/*, /api/restore as those land. Pick any PIN and
# share it only with whoever should be able to touch this box's admin/
# discovery routes. IMPORTANT: if this is left blank, those routes are NOT
# protected at all -- server.js's requireAdminPin() only checks a PIN when
# one is configured here. Set a real value before running a scan for real.
ADMIN_PIN=

# Retired 2026-09-22 (cloud patch_036). Staff no longer type a PIN: the
# Bar Ops app's TV Staff tile hands each person a signed pass (checked
# here against sha256(AGENT_TOKEN), no cloud round trip), and the owner
# sets how long it lasts under TV Admin. Leave this blank. If you do set
# one it still opens the control routes -- a setup/emergency path only.
STAFF_PIN=

# Optional. Personal access token for SmartThings (capability:switch and
# capability:audioVolume/audioMute scopes) -- docs/venue-control.md §7.2:
# the power/volume fallback used when a TV isn't reachable over the local
# WS remote-control protocol (older/asleep sets, or before WS pairing has
# happened). Leave blank and that fallback path is simply unavailable --
# power/volume operations still work over WS where possible, they just
# can't fall back to the cloud path. Get one from
# https://account.smartthings.com/tokens.
SMARTTHINGS_TOKEN=

# Optional, defaults to 8088.
PORT=8088

# Speed tests on the bar's Dream Machine (cloud patch 2026-09-26). Make a
# local-only admin on the UDM: unifi.ui.com -> this console -> Settings ->
# Admins & Users -> Add Admin -> "Restrict to local access only", Network
# role Site Admin (the test needs to be started, not just read). Put its
# username/password here. UNIFI_URL is the gateway's LAN address. With these
# blank the box never runs a test and the cloud keeps whatever it has.
UNIFI_URL=https://10.1.40.1
UNIFI_USER=
UNIFI_PASS=
UNIFI_SITE=default
SPEEDTEST_EVERY_HOURS=6

# Music (Sept 2026): the bar's Sonos Connect / Port on the AV VLAN plays
# Pandora itself; this box only sends it play / pause / skip / station
# over the local network. Leave SONOS_IP blank and the box finds the
# player by itself; set it if the Sonos has a reserved address (best).
# Stations = whatever is saved under My Sonos in the Sonos app.
SONOS_IP=
SONOS_PORT=1400

# Kasa smart plugs (Lights). Plugs set up with the kasa-test tool (or never
# linked to a TP-Link account) need nothing here. Only if some plugs were
# added through the Kasa app, put that app login here so the box can talk
# to them.
KASA_USER=
KASA_PASS=

# The bar's Pandora account, so the staff Music page lists every station
# on it and "+ Add station" can make new ones. Use one Pandora account per
# bar: Pandora plays an account in one place at a time. Test it with
#   node tools/pandora-test.js
PANDORA_USER=
PANDORA_PASS=
